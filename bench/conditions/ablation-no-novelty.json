{
  "name": "spyglass-no-novelty",
  "description": "ABLATION A1: Spyglass without novelty -- the same engine binary and config run with --ablation no-novelty (novel_templates disabled, w_n = 0, no template candidates in the bundle), the same SOP, the same deployer and gate. Isolates the contribution of the headline tool.",
  "instructions_file": "agent/sop.md",
  "model": {
    "name": "$MODEL_A"
  },
  "mcp_servers": [
    {
      "name": "spyglass-engine-ablation",
      "enable_tools": [
        "@all"
      ],
      "disable_tools": [
        "novel_templates"
      ],
      "preload": true
    },
    {
      "name": "spyglass-deployer",
      "enable_tools": [
        "@all"
      ],
      "preload": true,
      "require_approval_for_tools": [
        "rollback"
      ]
    }
  ],
  "config": {
    "iteration_limit": 80,
    "sandbox": {
      "enabled": true
    },
    "ask_user_questions": {
      "enabled": false
    },
    "dynamic_sub_agents": {
      "enabled": true
    },
    "generative_ui": {
      "enabled": false
    },
    "context_management": {
      "compaction": {
        "enabled": false
      },
      "large_tool_response": {
        "enabled": false
      }
    }
  }
}