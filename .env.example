# Copy to .env (gitignored) and fill in. Never commit .env.
#
# Model provider for the agent. Phase 0 verified 8 providers are available
# (openai, anthropic, google-gemini, fireworks, zai, moonshot, alibaba,
# together) plus `custom` for any OpenAI-compatible endpoint.
#
# MODEL_PROVIDER must match a `type` from:
#   curl -s localhost:8790/api/v1/catalogs/model-providers | jq -r '.data[].type'
MODEL_PROVIDER=google-gemini
MODEL_API_KEY=

# Model A is the benchmark's primary model; Model B is the optional
# generalization cell. Both are plain config — the engine never knows which
# model is reading (see README, "Why model configurability matters").
MODEL_A=gemini-3.6-flash
MODEL_B=gemini-3.1-pro-preview

# Host ports for the target system (container ports never change). Override
# when something else already owns one -- 8080 usually does.
GATEWAY_PORT=8080
ORDERS_PORT=8081
PAYMENTS_V1_PORT=8082
PAYMENTS_V2_PORT=8083

# Which saved TrueForge agent answers the watcher's alert (see scripts/tf-setup.py).
# spyglass-baseline = raw tools (the control group); spyglass = the evidence plane (Phase 3).
SPYGLASS_AGENT=spyglass-baseline
